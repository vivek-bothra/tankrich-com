      "publisher": { "@id": "https://www.tankrich.com/#person" }
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://www.tankrich.com/#business",
      "name": "Tankrich",
      "url": "https://www.tankrich.com",
      "description": "AI consulting practice helping businesses and solopreneurs deploy practical AI solutions — social automation, GPT agents, RAG systems, dashboards, and 24/7 AI assistants.",
      "founder": { "@id": "https://www.tankrich.com/#person" },
      "areaServed": ["Australia", "Global"],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Melbourne",
        "addressRegion": "VIC",
        "addressCountry": "AU"
      },
      "email": "hello@tankrich.com",
      "telephone": "+919352194655",
      "priceRange": "$$",
      "serviceType": ["AI Consulting", "AI Product Development", "Business Automation", "GPT Agent Development", "RAG Implementation"],
      "knowsAbout": ["Artificial Intelligence", "Machine Learning", "GPT-4", "Claude AI", "RAG", "Social Media Automation", "Business Intelligence", "Web Development"],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "AI Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Autonomous Social Media Management",
