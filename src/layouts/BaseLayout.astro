---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = "Tankrich — AI Consulting & Products | Vivek Bothra, Melbourne Australia",
  description = "Practical AI solutions for businesses and solopreneurs. Social automation, GPT agents, RAG systems, AI dashboards, and 24/7 assistants. Concept to deployed product in 3 weeks. Melbourne, Australia.",
  ogImage = "https://www.tankrich.com/og-image.png",
  canonicalUrl = "https://www.tankrich.com",
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.tankrich.com/#website",
      "url": "https://www.tankrich.com",
      "name": "Tankrich",
