---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title = "Tankrich AI Consulting — Enterprise AI Strategy, Build & Automation | Melbourne",
  description = "Tankrich AI Consulting helps organisations turn artificial intelligence into business outcomes — AI strategy, accelerated product development, RAG and knowledge systems, intelligent agents, and decision intelligence. Made in Melbourne, serving the world.",
  ogImage = "https://www.tankrich.com/og-image.png",
  canonicalUrl = "https://www.tankrich.com",
} = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://www.tankrich.com/#website",
      "url": "https://www.tankrich.com",
      "name": "Tankrich AI Consulting",
      "description": "Enterprise AI consulting — strategy, product development, RAG, intelligent agents, and decision intelligence.",
      "publisher": { "@id": "https://www.tankrich.com/#organization" },
      "inLanguage": "en"
    },
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": "https://www.tankrich.com/#organization",
      "name": "Tankrich AI Consulting",
      "alternateName": "Tankrich",
      "url": "https://www.tankrich.com",
      "logo": "https://www.tankrich.com/og-image.png",
      "image": "https://www.tankrich.com/og-image.png",
      "slogan": "Made in Melbourne. Serving the world.",
      "description": "Tankrich AI Consulting is a specialist artificial intelligence consultancy. We help organisations move from AI ambition to production — strategy and advisory, accelerated AI product development, RAG and knowledge systems, intelligent agents and automation, conversational AI, and decision intelligence.",
      "areaServed": ["Worldwide", "Australia", "India", "Global"],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Melbourne",
        "addressRegion": "VIC",
        "addressCountry": "AU"
      },
      "foundingLocation": {
        "@type": "Place",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Melbourne",
          "addressRegion": "VIC",
          "addressCountry": "AU"
        }
      },
      "email": "hello@tankrich.com",
      "telephone": "+919352194655",
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+919352194655",
        "contactType": "sales",
        "availableLanguage": ["English"],
        "areaServed": "Worldwide"
      },
      "priceRange": "$$",
      "knowsAbout": [
        "Artificial Intelligence Consulting",
        "Generative AI",
        "Large Language Models",
        "Retrieval Augmented Generation",
        "AI Agents",
        "Machine Learning",
        "Business Automation",
        "Decision Intelligence",
        "AI Product Development"
      ],
      "serviceType": [
        "AI Strategy & Advisory",
        "AI Product Development",
        "RAG & Knowledge Systems",
        "Intelligent Agents & Automation",
        "Conversational AI",
        "Data, Analytics & Decision Intelligence"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "AI Consulting Services",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "AI Strategy & Advisory", "description": "AI opportunity assessment and a prioritised, ROI-led adoption roadmap." } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Accelerated AI Product Development", "description": "Concept to production-ready, full-stack AI-native product in weeks." } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "RAG & Knowledge Systems", "description": "Retrieval-Augmented Generation grounding AI answers in your verified knowledge." } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Intelligent Agents & Automation", "description": "Custom AI agents and copilots tuned to your exact business workflows." } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Conversational & Customer AI", "description": "Always-on AI assistants on web, WhatsApp and Telegram, trained on your data." } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Data, Analytics & Decision Intelligence", "description": "Live dashboards, automated signals and decision intelligence on your data." } }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.tankrich.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What does Tankrich AI Consulting do?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tankrich AI Consulting is a specialist AI consultancy. We provide AI strategy and advisory, accelerated AI product development, RAG and knowledge systems, intelligent agents and automation, conversational AI, and data and decision intelligence — taking organisations from AI ambition to production systems."
          }
        },
        {
          "@type": "Question",
          "name": "How quickly can Tankrich deliver an AI solution?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most engagements move from concept to a deployed, production-ready solution within a few weeks. We work in fast, visible iterations rather than long, opaque projects."
          }
        },
        {
          "@type": "Question",
          "name": "Where is Tankrich AI Consulting based and who does it serve?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tankrich AI Consulting is based in Melbourne, Australia and serves clients worldwide — with delivered work across Australia, India and global markets. Engagements run over WhatsApp, email and video."
          }
        },
        {
          "@type": "Question",
          "name": "Is our data secure with Tankrich's AI systems?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We build on open frameworks and design for data ownership — your data stays yours, is never resold, and is never used to train external models. RAG and knowledge systems keep answers grounded in your verified sources."
          }
        }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content="Tankrich AI Consulting" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="keywords" content="AI consulting, AI consultancy, artificial intelligence consulting, AI strategy, AI product development, RAG, generative AI, AI agents, AI automation, Melbourne AI consulting" />
    <meta name="geo.region" content="AU-VIC" />
    <meta name="geo.placename" content="Melbourne" />
    <meta name="geo.position" content="-37.8136;144.9631" />
    <meta name="ICBM" content="-37.8136, 144.9631" />

    <!-- OG Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Tankrich AI Consulting" />
    <meta property="og:locale" content="en_AU" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <style>
      :root {
        --bg: #ffffff;
        --bg-alt: #f6f7fb;
        --bg-ink: #0c0e1a;
        --surface: #ffffff;
        --border: #e6e8f0;
        --border-strong: #d4d7e3;
        --ink: #0f1222;
        --body: #41465a;
        --muted: #6b7185;
        --accent: #5b34d6;
        --accent-2: #c026d3;
        --accent-soft: #f1ecfe;
        --live: #0ea371;
        --max: 1180px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        background-color: var(--bg);
        color: var(--body);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-size: 17px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-x: hidden;
      }

      h1, h2, h3, h4 {
        color: var(--ink);
        letter-spacing: -0.02em;
        line-height: 1.1;
      }

      .gradient-text {
        background: linear-gradient(115deg, var(--accent) 0%, var(--accent-2) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .eyebrow {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .container {
        max-width: var(--max);
        margin-left: auto;
        margin-right: auto;
        padding-left: 24px;
        padding-right: 24px;
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
