        "https://github.com/vivek-bothra"
      ],
      "knowsAbout": ["Artificial Intelligence", "GPT-4", "Claude", "RAG", "Python", "Next.js", "React", "Supabase", "Business Automation"]
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.tankrich.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What AI services does Tankrich offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tankrich offers autonomous social media management, custom GPT agents for business workflows, AI-driven dashboards, accelerated AI product development (concept to MVP in 3 weeks), secure personal AI assistants for WhatsApp/Telegram/web, and RAG implementations for business knowledge."
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take to build an AI solution with Tankrich?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most solutions are live within 1-3 weeks. The average time from concept to deployed, production-ready product is 3 weeks."
          }
        },
