          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Custom GPT Agents",
              "description": "Custom GPT agents built for your exact business workflow — data entry, research, drafting, and automation"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "AI-Driven Business Dashboards",
              "description": "Live intelligent dashboards with signals, momentum trackers, and KPI views built on your data"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Accelerated AI Product Development",
