            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Secure AI Assistants",
              "description": "24/7 AI assistants on WhatsApp, Telegram, and web — trained on your data, open-source stack"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "RAG for Business",
              "description": "Retrieval Augmented Generation grounding AI answers in your verified business knowledge"
            }
          }
        ]
      }
    },
    {
      "@type": "Person",
      "@id": "https://www.tankrich.com/#person",
      "name": "Vivek Bothra",
