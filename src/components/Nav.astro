---
---
<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="container py-4 flex items-center justify-between">
    <a href="#" class="brand flex items-center gap-2 font-extrabold tracking-tight text-lg" aria-label="Tankrich AI Consulting home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span>Tankrich<span class="brand-sub"> AI Consulting</span></span>
    </a>

    <!-- Desktop Links -->
    <div class="hidden md:flex items-center gap-8">
      <a href="#services" class="nav-link">Services</a>
      <a href="#work" class="nav-link">Case Studies</a>
      <a href="#approach" class="nav-link">Approach</a>
      <a href="#about" class="nav-link">About</a>
      <a href="#contact" class="nav-cta">Contact Us</a>
    </div>

    <!-- Mobile Hamburger -->
    <button id="hamburger" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Toggle menu">
      <span class="hamburger-line block w-6 h-0.5 transition-all duration-300"></span>
      <span class="hamburger-line block w-6 h-0.5 transition-all duration-300"></span>
      <span class="hamburger-line block w-6 h-0.5 transition-all duration-300"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden container pb-6">
    <div class="flex flex-col gap-4 pt-4" style="border-top: 1px solid var(--border);">
      <a href="#services" class="nav-link">Services</a>
      <a href="#work" class="nav-link">Case Studies</a>
      <a href="#approach" class="nav-link">Approach</a>
      <a href="#about" class="nav-link">About</a>
      <a href="#contact" class="nav-cta inline-block text-center">Contact Us</a>
    </div>
  </div>
</nav>

<style>
  #navbar {
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  #navbar.scrolled {
    background: rgba(255,255,255,0.92);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 1px 20px rgba(15,18,34,0.04);
  }

  .brand { color: var(--ink); }
  .brand-sub { color: var(--accent); font-weight: 700; }
  .brand-mark {
    width: 20px; height: 20px; border-radius: 6px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 2px 10px rgba(91,52,214,0.35);
  }

  .nav-link {
    font-size: 15px;
    font-weight: 500;
    color: var(--body);
    transition: color 0.18s ease;
  }
  .nav-link:hover { color: var(--accent); }

  .nav-cta {
    padding: 9px 18px;
    border-radius: 9px;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 4px 14px rgba(91,52,214,0.25);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .nav-cta:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(91,52,214,0.35); }

  .hamburger-line { background: var(--ink); }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerLines = document.querySelectorAll('.hamburger-line');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) navbar?.classList.add('scrolled');
    else navbar?.classList.remove('scrolled');
  });

  hamburger?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      hamburgerLines[0]?.style && (hamburgerLines[0].style.transform = '');
      hamburgerLines[1]?.style && (hamburgerLines[1].style.opacity = '1');
      hamburgerLines[2]?.style && (hamburgerLines[2].style.transform = '');
    } else {
      mobileMenu?.classList.remove('hidden');
      hamburgerLines[0] && ((hamburgerLines[0] as HTMLElement).style.transform = 'rotate(45deg) translate(4px, 4px)');
      hamburgerLines[1] && ((hamburgerLines[1] as HTMLElement).style.opacity = '0');
      hamburgerLines[2] && ((hamburgerLines[2] as HTMLElement).style.transform = 'rotate(-45deg) translate(4px, -4px)');
    }
  });

  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => mobileMenu?.classList.add('hidden'));
  });
</script>
