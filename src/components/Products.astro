---
import { services } from '../data/products';
---

<section id="services" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">What we do</span>
      <h2 class="section-title">A full AI team, end to end</h2>
      <p class="section-lead">
        From the first strategy conversation to systems running in production, Tankrich gives small businesses and founders the full lifecycle of AI adoption, without hiring a single engineer.
      </p>
    </div>

    <div class="svc-grid">
      {services.map(service => (
        <article class="svc-card">
          <div class="svc-icon" aria-hidden="true">{service.icon}</div>
          <h3 class="svc-name">{service.name}</h3>
          <p class="svc-desc">{service.description}</p>
          {service.bullets && (
            <ul class="svc-list">
              {service.bullets.map(b => (
                <li><span class="svc-tick" aria-hidden="true">→</span>{b}</li>
              ))}
            </ul>
          )}
          <div class="svc-tags">
            {service.tags.map(tag => <span class="svc-tag">{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .section { padding: 112px 0; }

  .section-head { max-width: 680px; margin-bottom: 64px; }
  .section-title {
    font-size: clamp(32px, 4.4vw, 50px);
    font-weight: 700;
    margin: 16px 0 20px;
  }
  .section-lead { font-size: 19px; color: var(--muted); line-height: 1.6; }

  .svc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }
  @media (min-width: 700px) { .svc-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .svc-grid { grid-template-columns: repeat(3, 1fr); } }

  .svc-card {
    background: #fff;
    padding: 34px 30px;
    transition: background 0.2s ease;
  }
  .svc-card:hover { background: var(--bg-alt); }

  .svc-icon {
    font-size: 26px;
    line-height: 1;
    margin-bottom: 22px;
  }

  .svc-name { font-size: 20px; font-weight: 700; margin-bottom: 12px; }
  .svc-desc { font-size: 15.5px; color: var(--muted); line-height: 1.6; margin-bottom: 18px; }

  .svc-list { list-style: none; margin-bottom: 20px; }
  .svc-list li {
    display: flex; gap: 10px; align-items: flex-start;
    font-size: 14.5px; color: var(--body); line-height: 1.5;
    padding: 6px 0;
  }
  .svc-tick { color: var(--accent); font-weight: 700; flex-shrink: 0; }

  .svc-tags { display: flex; flex-wrap: wrap; gap: 7px; }
  .svc-tag {
    font-size: 12px; font-weight: 500;
    padding: 4px 10px; border-radius: 6px;
    background: var(--bg-alt); color: var(--muted);
    border: 1px solid var(--border);
  }
  .svc-card:hover .svc-tag { background: #fff; }
</style>
