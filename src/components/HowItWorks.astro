---
const steps = [
  {
    number: "01",
    title: "Discover & Assess",
    description: "We map your operations and data, then identify the highest-ROI AI opportunities. You get a clear, jargon-free view of what's worth building, and what isn't."
  },
  {
    number: "02",
    title: "Design & Architect",
    description: "We define the solution architecture, model strategy, and data flows, built for security, accuracy and scale from day one, not bolted on later."
  },
  {
    number: "03",
    title: "Build & Ship",
    description: "We build in fast, visible iterations and deploy to production. Most solutions go live within weeks, with progress you can see at every stage."
  },
  {
    number: "04",
    title: "Run & Scale",
    description: "We measure what's working, refine what isn't, and expand your AI footprint as the business grows. Continuous improvement is built in."
  }
];
---

<section id="approach" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">How we work</span>
      <h2 class="section-title">A clear path from ambition to production</h2>
      <p class="section-lead">
        A disciplined, transparent engagement model, designed to de-risk AI adoption and get value into your business fast.
      </p>
    </div>

    <div class="step-grid">
      {steps.map(step => (
        <div class="step-card">
          <div class="step-number" aria-hidden="true">{step.number}</div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section { padding: 112px 0; }
  .section-head { max-width: 680px; margin-bottom: 64px; }
  .section-title { font-size: clamp(32px, 4.4vw, 50px); font-weight: 700; margin: 16px 0 20px; }
  .section-lead { font-size: 19px; color: var(--muted); line-height: 1.6; }

  .step-grid { display: grid; grid-template-columns: 1fr; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; }
  @media (min-width: 640px) { .step-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .step-grid { grid-template-columns: repeat(4, 1fr); } }

  .step-card { background: #fff; padding: 36px 30px; transition: background 0.2s ease; }
  .step-card:hover { background: var(--bg-alt); }

  .step-number {
    font-size: 30px; font-weight: 700; letter-spacing: -0.02em;
    color: var(--accent);
    margin-bottom: 24px;
  }
  .step-title { font-size: 19px; font-weight: 700; margin-bottom: 12px; }
  .step-desc { font-size: 15px; color: var(--muted); line-height: 1.6; }
</style>
