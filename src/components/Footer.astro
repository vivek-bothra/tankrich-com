---
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand-col">
        <a href="#" class="footer-brand" aria-label="Tankrich AI Consulting home">
          <span class="footer-mark" aria-hidden="true"></span>
          Tankrich <span class="footer-brand-sub">AI Consulting</span>
        </a>
        <p class="footer-tagline">
          AI consulting, strategy, product development, RAG, intelligent agents and decision intelligence. Made in Melbourne, serving the world.
        </p>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <h4 class="footer-heading">Explore</h4>
          <a href="#services">Services</a>
          <a href="#work">Case Studies</a>
          <a href="#approach">Approach</a>
          <a href="#about">About</a>
        </div>
        <div class="footer-col">
          <h4 class="footer-heading">Contact</h4>
          <a href="https://wa.me/919352194655" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <a href="mailto:hello@tankrich.com">hello@tankrich.com</a>
          <span class="footer-static">Melbourne, Australia</span>
          <span class="footer-static">Serving clients worldwide</span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} Tankrich AI Consulting. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer { background: #fff; border-top: 1px solid var(--border); padding: 64px 0 36px; }

  .footer-top { display: grid; grid-template-columns: 1fr; gap: 40px; padding-bottom: 40px; border-bottom: 1px solid var(--border); }
  @media (min-width: 820px) { .footer-top { grid-template-columns: 1.4fr 1fr; } }

  .footer-brand { display: inline-flex; align-items: center; gap: 9px; font-size: 19px; font-weight: 800; color: var(--ink); margin-bottom: 14px; }
  .footer-brand-sub { color: var(--accent); }
  .footer-mark { width: 20px; height: 20px; border-radius: 6px; background: linear-gradient(135deg, var(--accent), var(--accent-2)); }
  .footer-tagline { font-size: 15px; color: var(--muted); line-height: 1.65; max-width: 420px; }

  .footer-links { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
  .footer-col { display: flex; flex-direction: column; gap: 11px; }
  .footer-heading { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink); margin-bottom: 4px; }
  .footer-col a, .footer-static { font-size: 15px; color: var(--muted); transition: color 0.18s ease; }
  .footer-col a:hover { color: var(--accent); }

  .footer-bottom { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; padding-top: 28px; }
  .footer-bottom p { font-size: 13.5px; color: var(--muted); }
</style>
