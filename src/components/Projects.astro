---
import { caseStudies } from '../data/projects';
---

<section id="work" class="section section-alt">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Selected case studies</span>
      <h2 class="section-title">Our work, in production</h2>
      <p class="section-lead">
        Every engagement below shipped a real system that’s live today. Open any one to read the full story, the challenge we were handed, what we built, and the difference it made.
      </p>
    </div>

    <div class="cs-grid">
      {caseStudies.map(cs => {
        const modalId = `cs-modal-${cs.id}`;
        return (
          <>
            <article class="cs-card">
              <div class="cs-card-top">
                <span class="cs-icon" aria-hidden="true">{cs.icon}</span>
                <span class="cs-region">{cs.region}</span>
              </div>
              <p class="cs-sector">{cs.sector}</p>
              <h3 class="cs-client">{cs.client}</h3>
              <p class="cs-title">{cs.title}</p>
              <p class="cs-summary">{cs.summary}</p>
              <div class="cs-tags">
                {cs.tags.slice(0, 4).map(tag => <span class="cs-tag">{tag}</span>)}
              </div>
              <button data-cs-modal={modalId} class="cs-readmore">
                Read case study <span aria-hidden="true">→</span>
              </button>
            </article>

            <!-- Modal -->
            <div id={modalId} class="modal-overlay" role="dialog" aria-modal="true" aria-label={`${cs.client} case study`}>
              <div class="modal-container">
                <div class="modal-header">
                  <div class="flex items-center gap-3 min-w-0">
                    <span class="cs-icon-sm" aria-hidden="true">{cs.icon}</span>
                    <div class="min-w-0">
                      <h3 class="modal-client">{cs.client}</h3>
                      <p class="modal-sector">{cs.sector} · {cs.region}</p>
                    </div>
                  </div>
                  <button class="modal-close" data-cs-close={modalId} aria-label="Close case study">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                  </button>
                </div>

                <div class="modal-body">
                  <p class="modal-title">{cs.title}</p>

                  <div class="story-block">
                    <div class="story-row">
                      <span class="story-kicker">The challenge</span>
                      <p class="story-text">{cs.challenge}</p>
                    </div>
                    <div class="story-row">
                      <span class="story-kicker">What we built</span>
                      <p class="story-text">{cs.approach}</p>
                    </div>
                    <div class="story-row story-impact">
                      <span class="story-kicker">The impact</span>
                      <p class="story-text">{cs.outcome}</p>
                    </div>
                  </div>

                  <div class="modal-tags">
                    {cs.tags.map(tag => <span class="cs-tag">{tag}</span>)}
                  </div>

                  {cs.liveUrl && (
                    <a href={cs.liveUrl} target="_blank" rel="noopener noreferrer" class="modal-visit">
                      Visit {cs.liveUrl.replace(/^https?:\/\//, '')}
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </>
        );
      })}
    </div>
  </div>
</section>

<style>
  .section { padding: 112px 0; }
  .section-alt { background: var(--bg-alt); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

  .section-head { max-width: 720px; margin-bottom: 64px; }
  .section-title { font-size: clamp(32px, 4.4vw, 50px); font-weight: 700; margin: 16px 0 20px; }
  .section-lead { font-size: 19px; color: var(--muted); line-height: 1.6; }

  .cs-grid {
    display: grid; grid-template-columns: 1fr; gap: 20px;
  }
  @media (min-width: 700px) { .cs-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1040px) { .cs-grid { grid-template-columns: repeat(3, 1fr); } }

  .cs-card {
    background: #fff; border: 1px solid var(--border); border-radius: 14px;
    padding: 28px 26px 24px; display: flex; flex-direction: column;
    transition: border-color 0.2s ease;
  }
  .cs-card:hover { border-color: var(--border-strong); }

  .cs-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
  .cs-icon { font-size: 26px; line-height: 1; }
  .cs-region {
    font-size: 11px; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase;
    color: var(--muted); background: var(--bg-alt);
    padding: 4px 9px; border-radius: 6px; border: 1px solid var(--border);
  }

  .cs-sector { font-size: 12.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 6px; }
  .cs-client { font-size: 22px; font-weight: 700; margin-bottom: 8px; }
  .cs-title { font-size: 15.5px; font-weight: 600; color: var(--ink); margin-bottom: 12px; line-height: 1.4; }
  .cs-summary { font-size: 14.5px; color: var(--muted); line-height: 1.6; flex: 1; margin-bottom: 18px; }

  .cs-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 20px; }
  .cs-tag {
    font-size: 12px; font-weight: 500; padding: 4px 10px; border-radius: 6px;
    background: var(--bg-alt); color: var(--muted); border: 1px solid var(--border);
  }
  .modal-tags .cs-tag { background: #fff; }

  .cs-readmore {
    align-self: flex-start;
    background: none; border: none; cursor: pointer;
    font-size: 15px; font-weight: 600; color: var(--accent);
    display: inline-flex; align-items: center; gap: 7px;
    transition: gap 0.18s ease;
  }
  .cs-readmore:hover { gap: 11px; }

  /* Modal */
  .modal-overlay {
    display: none; position: fixed; inset: 0; z-index: 1000;
    background: rgba(12,14,26,0.55);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    align-items: center; justify-content: center; padding: 16px;
  }
  .modal-overlay.open { display: flex; }

  .modal-container {
    background: #fff; border: 1px solid var(--border);
    border-radius: 20px; width: 100%; max-width: 760px; max-height: 90vh;
    display: flex; flex-direction: column; overflow: hidden;
    box-shadow: 0 30px 90px rgba(12,14,26,0.3);
    animation: modal-in 0.2s ease;
  }
  @keyframes modal-in { from { opacity: 0; transform: scale(0.97) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }

  .modal-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 22px; border-bottom: 1px solid var(--border); flex-shrink: 0; gap: 12px;
  }
  .cs-icon-sm {
    font-size: 24px; flex-shrink: 0; line-height: 1;
  }
  .modal-client { font-size: 18px; font-weight: 700; }
  .modal-sector { font-size: 13px; color: var(--muted); }

  .modal-close {
    color: var(--muted); background: var(--bg-alt); border: 1px solid var(--border);
    border-radius: 9px; width: 36px; height: 36px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    transition: all 0.15s ease;
  }
  .modal-close:hover { background: #fff; color: var(--ink); border-color: var(--border-strong); }

  .modal-body { padding: 24px 22px 26px; overflow-y: auto; }
  .modal-title { font-size: 20px; font-weight: 700; color: var(--ink); line-height: 1.35; margin-bottom: 22px; }

  .story-block { display: flex; flex-direction: column; gap: 20px; margin-bottom: 24px; }
  .story-row { padding-left: 16px; border-left: 2px solid var(--border-strong); }
  .story-row.story-impact { border-left-color: var(--accent); background: var(--accent-soft); border-radius: 0 10px 10px 0; padding: 14px 18px; }
  .story-kicker {
    display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--accent); margin-bottom: 6px;
  }
  .story-text { font-size: 15px; color: var(--body); line-height: 1.65; }

  .modal-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 24px; }

  .modal-visit {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 13px 22px; border-radius: 8px; font-weight: 600; font-size: 15px; color: #fff;
    background: var(--ink); border: 1px solid var(--ink);
    transition: background 0.18s ease;
  }
  .modal-visit:hover { background: #2a2e38; }
</style>

<script>
  document.querySelectorAll('[data-cs-modal]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = (btn as HTMLElement).dataset.csModal!;
      const modal = document.getElementById(id);
      if (!modal) return;
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    });
  });

  document.querySelectorAll('[data-cs-close]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = (btn as HTMLElement).dataset.csClose!;
      document.getElementById(id)?.classList.remove('open');
      document.body.style.overflow = '';
    });
  });

  document.querySelectorAll('.modal-overlay').forEach(overlay => {
    overlay.addEventListener('click', e => {
      if (e.target === overlay) {
        (overlay as HTMLElement).classList.remove('open');
        document.body.style.overflow = '';
      }
    });
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      document.querySelectorAll('.modal-overlay.open').forEach(m => {
        m.classList.remove('open');
        document.body.style.overflow = '';
      });
    }
  });
</script>
