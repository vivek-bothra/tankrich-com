---
const principles = [
  { title: "Outcomes, not demos", text: "We ship systems that run in production and move real business metrics — not slideware or proof-of-concepts that never leave the lab." },
  { title: "Grounded & secure", text: "We design for accuracy and data ownership. Your data stays yours, answers stay grounded in your verified knowledge, and trust is engineered in." },
  { title: "Fast by design", text: "Modern AI-native delivery means weeks, not quarters. You see working software early and often, with no black boxes." },
  { title: "Pragmatic adoption", text: "We pick the highest-leverage opportunity and the right tool for it — never AI for its own sake, never lock-in for ours." },
];
---

<section id="about" class="section section-alt">
  <div class="container">
    <div class="about-grid">
      <div>
        <span class="eyebrow">About Tankrich</span>
        <h2 class="about-title">A specialist AI consultancy, made in Melbourne</h2>
        <p class="about-lead">
          Tankrich AI Consulting helps organisations turn artificial intelligence into a working part of their business. We combine strategy, engineering and product delivery to take clients from AI ambition to systems that run in the real world.
        </p>
        <p class="about-body">
          Founded in Melbourne, Australia, we serve clients worldwide — with delivered work across Australia, India and global markets, spanning field operations, manufacturing, financial services, education and consumer products. Made in Melbourne, serving the world.
        </p>

        <div class="about-badges">
          <span class="about-badge">📍 Melbourne, Australia</span>
          <span class="about-badge">🌏 Serving clients worldwide</span>
        </div>

        <a href="#contact" class="about-cta">Start a conversation →</a>
      </div>

      <div class="principles">
        {principles.map(p => (
          <div class="principle-card">
            <h3 class="principle-title">{p.title}</h3>
            <p class="principle-text">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .section { padding: 96px 0; }
  .section-alt { background: var(--bg-alt); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }

  .about-grid { display: grid; grid-template-columns: 1fr; gap: 48px; align-items: start; }
  @media (min-width: 940px) { .about-grid { grid-template-columns: 1.05fr 1fr; gap: 64px; } }

  .about-title { font-size: clamp(28px, 3.6vw, 40px); font-weight: 800; margin: 14px 0 20px; }
  .about-lead { font-size: 19px; color: var(--body); line-height: 1.6; margin-bottom: 18px; }
  .about-body { font-size: 16px; color: var(--muted); line-height: 1.7; margin-bottom: 26px; }

  .about-badges { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 30px; }
  .about-badge {
    font-size: 14px; font-weight: 600; color: var(--ink);
    background: #fff; border: 1px solid var(--border);
    padding: 9px 16px; border-radius: 999px;
  }

  .about-cta { font-size: 16px; font-weight: 600; color: var(--accent); display: inline-flex; gap: 7px; align-items: center; transition: gap 0.18s ease; }
  .about-cta:hover { gap: 11px; }

  .principles { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 560px) { .principles { grid-template-columns: repeat(2, 1fr); } }

  .principle-card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 24px 22px; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
  .principle-card:hover { border-color: rgba(91,52,214,0.3); box-shadow: 0 12px 30px rgba(15,18,34,0.06); }
  .principle-title { font-size: 17px; font-weight: 700; margin-bottom: 9px; }
  .principle-text { font-size: 14.5px; color: var(--muted); line-height: 1.6; }
</style>
