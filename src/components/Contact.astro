<section id="contact" class="section section-alt">
  <div class="container">
    <div class="contact-card">
      <div class="contact-glow" aria-hidden="true"></div>
      <div class="contact-inner">
        <span class="eyebrow" style="color:#fff;opacity:0.85;">Get in touch</span>
        <h2 class="contact-title">Ready to put AI to work?</h2>
        <p class="contact-lead">
          Tell us about your business and the outcome you're after. No jargon, no fluff — just a clear conversation about practical AI that delivers. The fastest way to reach us is WhatsApp.
        </p>

        <div class="contact-actions">
          <a href="https://wa.me/919352194655" target="_blank" rel="noopener noreferrer" class="contact-whatsapp">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Message us on WhatsApp
          </a>
          <a href="mailto:hello@tankrich.com" class="contact-email">hello@tankrich.com</a>
        </div>

        <p class="contact-note">📍 Melbourne, Australia · serving clients worldwide · +91 93521 94655</p>
      </div>
    </div>
  </div>
</section>

<style>
  .section { padding: 96px 0; }
  .section-alt { background: var(--bg-alt); border-top: 1px solid var(--border); }

  .contact-card {
    position: relative; overflow: hidden;
    border-radius: 26px;
    background: linear-gradient(135deg, #1a1340 0%, #2d1a5e 45%, #4a1d6b 100%);
    padding: 64px 32px;
  }
  .contact-glow {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 50% 60% at 85% 10%, rgba(192,38,211,0.35), transparent 60%),
      radial-gradient(ellipse 50% 60% at 10% 100%, rgba(91,52,214,0.4), transparent 60%);
    pointer-events: none;
  }
  .contact-inner { position: relative; z-index: 1; max-width: 640px; margin: 0 auto; text-align: center; }

  .contact-title { font-size: clamp(30px, 4.4vw, 46px); font-weight: 800; color: #fff; margin: 14px 0 18px; }
  .contact-lead { font-size: 18px; color: rgba(255,255,255,0.8); line-height: 1.6; margin-bottom: 34px; }

  .contact-actions { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; align-items: center; margin-bottom: 26px; }

  .contact-whatsapp {
    display: inline-flex; align-items: center; gap: 11px;
    padding: 15px 28px; border-radius: 12px; font-weight: 700; font-size: 16px; color: #fff;
    background: #25d366; box-shadow: 0 10px 30px rgba(37,211,102,0.3);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .contact-whatsapp:hover { transform: translateY(-2px); box-shadow: 0 14px 38px rgba(37,211,102,0.45); }

  .contact-email {
    font-size: 16px; font-weight: 600; color: #fff;
    padding: 15px 24px; border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.25);
    transition: background 0.18s ease;
  }
  .contact-email:hover { background: rgba(255,255,255,0.1); }

  .contact-note { font-size: 14px; color: rgba(255,255,255,0.6); }
</style>
