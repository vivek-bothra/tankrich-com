---
---
<section id="hero" class="hero-section relative overflow-hidden">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-orb hero-orb-1" aria-hidden="true"></div>
  <div class="hero-orb hero-orb-2" aria-hidden="true"></div>

  <div class="container relative z-10">
    <div class="max-w-4xl pt-36 pb-24 md:pt-44 md:pb-32">
      <div class="hero-badge">
        <span class="hero-dot" aria-hidden="true"></span>
        AI Consulting · Made in Melbourne, serving the world
      </div>

      <h1 class="hero-headline">
        <span class="gradient-text">AI consulting</span> that turns ambition into outcomes
      </h1>

      <p class="hero-sub">
        Tankrich AI Consulting helps organisations move from AI strategy to production systems — accelerated product development, RAG and knowledge platforms, intelligent agents, and decision intelligence. Real systems, shipped in weeks, running in the real world.
      </p>

      <div class="hero-actions">
        <a href="#contact" class="btn-primary">Book a consultation</a>
        <a href="#work" class="btn-secondary">Explore our work →</a>
      </div>

      <div class="hero-stats">
        <div class="hero-stat">
          <div class="hero-stat-value">Weeks</div>
          <div class="hero-stat-label">Concept to production</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-value">3 markets</div>
          <div class="hero-stat-label">Australia · India · Global</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-value">End-to-end</div>
          <div class="hero-stat-label">Strategy → build → run</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-value">24/7</div>
          <div class="hero-stat-label">AI systems in production</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background:
      radial-gradient(ellipse 70% 50% at 80% 0%, rgba(14,165,233,0.06), transparent 60%),
      radial-gradient(ellipse 60% 50% at 0% 20%, rgba(37,99,235,0.07), transparent 55%),
      var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .hero-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(to right, rgba(15,18,34,0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15,18,34,0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 30%, transparent 75%);
  }

  .hero-orb {
    position: absolute; border-radius: 50%; filter: blur(90px); pointer-events: none;
  }
  .hero-orb-1 { width: 460px; height: 460px; background: rgba(37,99,235,0.12); top: -120px; right: -80px; }
  .hero-orb-2 { width: 380px; height: 380px; background: rgba(14,165,233,0.10); bottom: -120px; left: -60px; }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 7px 15px; border-radius: 999px;
    background: var(--accent-soft);
    border: 1px solid rgba(37,99,235,0.18);
    color: var(--accent);
    font-size: 13.5px; font-weight: 600;
    margin-bottom: 28px;
  }
  .hero-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--live);
    box-shadow: 0 0 0 4px rgba(14,163,113,0.15);
  }

  .hero-headline {
    font-size: clamp(40px, 6.2vw, 70px);
    font-weight: 800;
    margin-bottom: 26px;
  }

  .hero-sub {
    font-size: clamp(17px, 2.2vw, 21px);
    color: var(--muted);
    max-width: 720px;
    margin-bottom: 36px;
    line-height: 1.6;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 64px; }

  .btn-primary {
    padding: 15px 30px; border-radius: 11px;
    font-weight: 600; font-size: 16px; color: #fff;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 8px 24px rgba(37,99,235,0.28);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(37,99,235,0.4); }

  .btn-secondary {
    padding: 15px 28px; border-radius: 11px;
    font-weight: 600; font-size: 16px; color: var(--ink);
    background: #fff; border: 1px solid var(--border-strong);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .btn-secondary:hover { border-color: var(--accent); transform: translateY(-2px); }

  .hero-stats {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px;
    background: var(--border); border: 1px solid var(--border);
    border-radius: 16px; overflow: hidden;
    max-width: 760px;
  }
  @media (min-width: 720px) { .hero-stats { grid-template-columns: repeat(4, 1fr); } }

  .hero-stat { background: #fff; padding: 22px 20px; }
  .hero-stat-value {
    font-size: 24px; font-weight: 800; color: var(--ink); letter-spacing: -0.02em;
    margin-bottom: 4px;
  }
  .hero-stat-label { font-size: 13.5px; color: var(--muted); }
</style>
