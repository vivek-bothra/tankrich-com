---
---
<section id="hero" class="hero-section">
  <div class="container">
    <div class="hero-inner">
      <div class="hero-badge">
        <span class="hero-dot" aria-hidden="true"></span>
        AI Consulting · Made in Melbourne, serving the world
      </div>

      <h1 class="hero-headline">The tech team you never had.</h1>

      <p class="hero-sub">
        Tankrich AI Consulting gives small businesses and solo founders the AI strategy, products and automation that used to need a whole engineering department. Strategy to production systems, shipped in weeks, running in the real world.
      </p>

      <div class="hero-actions">
        <a href="#contact" class="btn-primary">Book a consultation</a>
        <a href="#work" class="btn-secondary">Explore our work →</a>
      </div>

      <div class="hero-stats">
        <div class="hero-stat">
          <div class="hero-stat-value">Weeks</div>
          <div class="hero-stat-label">Concept to production</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-value">3 markets</div>
          <div class="hero-stat-label">Australia · India · Global</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-value">End-to-end</div>
          <div class="hero-stat-label">Strategy → build → run</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-value">24/7</div>
          <div class="hero-stat-label">AI systems in production</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    max-width: 880px;
    padding-top: 152px;
    padding-bottom: 104px;
  }
  @media (min-width: 768px) {
    .hero-inner { padding-top: 184px; padding-bottom: 128px; }
  }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 7px 14px; border-radius: 999px;
    background: #fff;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 13px; font-weight: 500;
    margin-bottom: 32px;
  }
  .hero-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--live);
  }

  .hero-headline {
    font-size: clamp(46px, 7.5vw, 88px);
    font-weight: 700;
    letter-spacing: -0.035em;
    margin-bottom: 30px;
  }

  .hero-sub {
    font-size: clamp(18px, 2.2vw, 22px);
    color: var(--body);
    max-width: 680px;
    margin-bottom: 40px;
    line-height: 1.55;
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 72px; }

  .hero-stats {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 32px 24px;
    max-width: 780px;
    border-top: 1px solid var(--border);
    padding-top: 40px;
  }
  @media (min-width: 720px) { .hero-stats { grid-template-columns: repeat(4, 1fr); } }

  .hero-stat-value {
    font-size: 26px; font-weight: 700; color: var(--ink); letter-spacing: -0.03em;
    margin-bottom: 6px;
  }
  .hero-stat-label { font-size: 13.5px; color: var(--muted); line-height: 1.45; }
</style>
