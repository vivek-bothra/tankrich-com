---
const faqs = [
  {
    question: "What AI services does Tankrich offer?",
    answer: "We build autonomous social media management, custom GPT agents for business workflows, AI-driven dashboards, rapid AI product development (concept to MVP in 3 weeks), secure AI assistants for WhatsApp and Telegram, and RAG implementations that ground AI in your verified business knowledge."
  },
  {
    question: "How quickly can you build and deploy an AI solution?",
    answer: "Most solutions are live within 1–3 weeks. We move fast — from discovery call to deployed, production-ready product — with progress visible at every stage."
  },
  {
    question: "Do you work with clients outside Australia?",
    answer: "Yes. While based in Melbourne, Australia, we work with clients globally via WhatsApp and video calls. Our AI solutions are deployed on cloud infrastructure accessible worldwide."
  },
  {
    question: "Is my data secure with your AI assistants?",
    answer: "Absolutely. Our AI assistants are built on open-source frameworks. Your data stays yours — it's never shared with third parties and never used to train external models."
  },
  {
    question: "What is RAG and why does it matter for my business?",
    answer: "Retrieval Augmented Generation (RAG) grounds AI answers in your verified, authoritative business data — eliminating hallucinations and ensuring responses are accurate, current, and context-aware. It's the difference between a generic chatbot and an AI that truly knows your business."
  },
  {
    question: "What technologies do you use?",
    answer: "We work with GPT-4, Claude, custom RAG pipelines, Next.js, Astro, React, Supabase, Python, and deploy on Vercel and Cloudflare. We choose the best tool for each project rather than forcing a single stack."
  }
];
---

<section id="faq" class="py-24 px-6 relative">
  <div class="section-divider" aria-hidden="true"></div>

  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-16">
      <span class="text-sm font-semibold tracking-widest uppercase mb-4 block" style="color: #4f8cff;">FAQ</span>
      <h2 class="font-bold mb-4" style="color: #f0f4ff; font-size: clamp(28px, 4vw, 36px);">Frequently Asked Questions</h2>
      <p class="text-lg max-w-xl mx-auto" style="color: #8892b0;">Common questions about working with Tankrich</p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="faq-item rounded-2xl group">
          <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold" style="color: #f0f4ff;">
            <span class="pr-4">{faq.question}</span>
            <svg class="faq-chevron w-5 h-5 flex-shrink-0 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="px-6 pb-6">
            <p class="leading-relaxed" style="color: #8892b0;">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .section-divider {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(79,140,255,0.2), transparent);
  }

  .faq-item {
    background: rgba(13,15,30,0.8);
    border: 1px solid rgba(255,255,255,0.06);
    transition: all 0.2s ease;
  }

  .faq-item:hover {
    border-color: rgba(79,140,255,0.2);
  }

  .faq-item[open] {
    border-color: rgba(79,140,255,0.25);
    box-shadow: 0 4px 20px rgba(79,140,255,0.08);
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }
</style>
